# syntax=docker/dockerfile:1

# ------------------------------------------------------------------------
# Etapa 1: Frontend (Nuxt). Genera webui/.output/public, que el binario
# de Go embebe vía //go:embed.
# ------------------------------------------------------------------------
FROM node:22-alpine AS frontend
WORKDIR /build/webui

COPY webui/package.json webui/package-lock.json ./
RUN npm ci

COPY webui/ ./
RUN npm run generate

# ------------------------------------------------------------------------
# Etapa 2: Backend (Go). Compila el binario con el frontend embebido.
# CGO está habilitado porque dbmate (driver sqlite) depende de mattn/go-sqlite3.
# ------------------------------------------------------------------------
FROM golang:1.25 AS builder
WORKDIR /build

# `|direct` hace fallback al repositorio de origen ante cualquier error del
# proxy (p. ej. "stream error: ... INTERNAL_ERROR; received from peer").
ENV GOPROXY=https://proxy.golang.org|direct

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download \
    || (echo "go mod download falló, reintentando…" && sleep 5 && go mod download) \
    || (echo "go mod download falló de nuevo, último intento…" && sleep 20 && go mod download)

COPY . .
COPY --from=frontend /build/webui/.output /build/webui/.output

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -ldflags="-s -w" -o /out/trading-card-album .

# ------------------------------------------------------------------------
# Etapa 3: Runtime. Solo el binario + certificados (OAuth contra Google).
# ------------------------------------------------------------------------
FROM docker.io/debian:bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /out /app

ENV APP_PORT=8080
ENV DATABASE_URL=sqlite:database/trading-card-album.sqlite3

EXPOSE 8080

ENTRYPOINT ["/app/trading-card-album"]